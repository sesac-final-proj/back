# Runtime
APP_ENV=local
# ENV_FILE=.env.local

# DB
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gaji_market
DB_USER=postgres
DB_PASSWORD=change-me

# JWT
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Forbidden words
# Copy app/api/v1/nicknames/resources/forbidden_words.example.json
# to app/api/v1/nicknames/resources/forbidden_words.local.json
# and put local forbidden words there. Do not commit the real file.
FORBIDDEN_WORDS_PATH=app/api/v1/nicknames/resources/forbidden_words.local.json

# Redis
# Either set REDIS_URL directly, or set REDIS_HOST/REDIS_PW.
REDIS_URL=
REDIS_HOST=
REDIS_PW=

# Kakao OAuth
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_ADMIN_KEY=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/kakao/callback
# Naver OAuth
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/naver/callback

# Naver Maps
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY_SECRET=

# NCP Object Storage (중고거래 이미지)
NCP_ACCESS_KEY=your-ncp-object-storage-access-key
NCP_SECRET_KEY=your-ncp-object-storage-secret-key
NCP_BUCKET=your-bucket-name
NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_REGION=kr-standard
